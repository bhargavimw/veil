# VEIL environment configuration (copy to .env and adjust)
VEIL_PORT=8000
VEIL_DB_URL=sqlite:///./veil.db
# Comma-separated dashboard origins allowed to call the API (CORS).
VEIL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Fernet key for encrypted secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VEIL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Vault key for token/identity encryption at rest (generate a dev key if missing)
VEIL_VAULT_KEY=replace-with-a-generated-fernet-key
LOG_LEVEL=INFO
